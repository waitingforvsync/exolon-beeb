\\ sprites.6502 - the sprites (tools/gensprites.py) and the plotter that reads them, in the data's bank (P9, D30-D32).
\\ A large sprite (the 32- and 16-line sets) has its dirty edges cleared in phase 1 and its new rectangle drawn in
\\ phase 2: stored straight over empty cells, behind the screen's bit-3 pixels (the map's) over any other. The
\\ 8-line set is XORed (D10). Everything goes a band at a time: a character row's lines of a rectangle, each
\\ column of it unrolled over the band's lines, one Y for the sprite and the screen (as Chase H.Q.'s plotter).

INCLUDE "../build/gen/sprites.6502"     ; the sprites and their tables (tools/gensprites.py)

MaxSlots = 16                           ; large sprites on the screen at once (11 at most seen: 10 and the player)

SECTION Workspace
.SlotX                                  ; a large sprite's rectangle as drawn: byte column, line, bytes, lines
    SKIP MaxSlots                       ; (SlotW 0: nothing drawn)
.SlotY
    SKIP MaxSlots
.SlotW
    SKIP MaxSlots
.SlotH
    SKIP MaxSlots
.SlotS                                  ; its sprite (for an XOR off)
    SKIP MaxSlots
ENDSECTION

SECTION DataVars
.Keep                                   ; a screen byte's bit-3 pixels (the map's), the rest 0 (made by the loader)
    SKIP 256
.Hole                                   ; the pixels without bit 3: where a sprite shows
    SKIP 256
ENDSECTION
ASSERT LO(Keep) == 0 AND Hole == Keep + 256, "Keep and Hole on pages"

\\ The band walker's state

ZA_AUTO1 rx, ry, rw, rh                 ; the rectangle: byte column, line, bytes, lines
ZA_AUTO2 src                            ; the sprite's data: its band 0 (draws, XOR)
ZA_AUTO1 sw                             ; its bands' width in bytes: 8 × sw apart (draws, XOR)
ZA_AUTO1 mode                           ; ModeDraw, ModeClear or ModeXor
ZA_AUTO2 srca, srcb                     ; the steps' sprite pointers: the band above, and the band, so (p),Y reads
                                        ; column k line l at Y = 8k + l
ZA_AUTO2 scr                            ; the steps' screen pointer: the band's character row at rx

ModeDraw = 0                            ; a sprite stored straight, or behind the map's pixels
ModeClear = 2                           ; every pixel cleared but the map's
ModeXor = 4                             ; a sprite XORed onto every pixel but the map's

\\ Walk a large sprite's rectangle a band at a time: a character row's lines of it. Y is 8k + l for its column k,
\\ line l, on the screen and in the sprite alike, so a whole band's columns run through the unrolled steps with
\\ no realigning (V set); the first band is entered at its first line and the last left after its last by a
\\ 2-byte BNE patched over the next step (Y is never 0 there), and those realign Y each column. A sprite line
\\ under its phase (its top line AND 7) comes from the sprite's band above (srca), the rest from its band (srcb):
\\ the steps' operands are patched for the phase. The pointers, the screen's and the tile map's rows are stepped
\\ a band; the cells' range and 8 × rw are worked out once. Rows below the playfield are left alone: sprites
\\ hide behind the status rows. (The review of 2026-10-31.)
\\
\\ Inputs:
\\     rx, ry, rw, rh: the rectangle (on the screen: the caller clips it), rw and rh not 0, rh under 128
\\     mode: ModeDraw, ModeClear or ModeXor
\\     src, sw: the sprite's data and its width as stored (ModeDraw, ModeXor)
\\
\\ Outputs:
\\     rx, ry, rw, rh, mode: preserved
\\     A, X, Y: corrupted

.walk
{
    ZA_AUTO1 phase                      ; local: ry AND 7
    ZA_AUTO1 stride                     ; local: 8 × sw
    ZA_AUTO1 left1                      ; local: the lines after this band, less 1 (negative: none)
    ZA_AUTO1 first, n                   ; local: the band's first line in its cell, and its lines
    ZA_AUTO1 cell0, block               ; local: the first cell column; the band's block × 8
    ZA_AUTO2 tmap                       ; local: the band's tile map row
    ZA_AUTO2 exit, saved                ; local: the step after the last line (hi 0: none), its first 2 bytes

    LDA ry:AND #7:STA phase:STA first
    LDX mode:BEQ drawing
    CPX #ModeXor:BNE phased             ; (ModeClear: the steps read no sprite)
    CMP XorPhase:BEQ phased
    JSR set_xor_phase
    JMP phased
.drawing
    CMP DrawPhase:BEQ phased
    JSR set_draw_phase
.phased
    LDA sw:ASL A:ASL A:ASL A:STA stride
    LDA rw:ASL A:ASL A:ASL A:STA fullend+1  ; Y after a whole band's last column
    LDA rx:LSR A:STA cell0
    LDA rx:CLC:ADC rw:SBC #0            ; (C clear: less 1) the last column
    LSR A:STA lastcell+1                ; and its cell
    LDA src:SEC:SBC phase:STA srcb      ; the first band, lines from the phase: the sprite's band 0
    LDA src+1:SBC #0:STA srcb+1
    LDA #0:STA exit+1
    LDX rh:DEX:STX left1
    LDA ry:LSR A:LSR A:LSR A            ; the character row
    CMP #PlayRows:BCC onplay
    RTS                                 ; (the status rows: nothing below shows)
.onplay
    TAX
    LDA TileRowLo,X:STA tmap
    LDA TileRowHi,X:STA tmap+1
    LDA rx:ASL A:ASL A:ASL A:STA scr    ; rx × 8, low byte (C: its bit 8)
    TXA:ROL A                           ; the row × 2, and rx × 8's bit 8: the row's pages
    ADC #HI(ScreenAddr):STA scr+1       ; (C clear: under &80)

    \\ a band: straight if its cells are all empty, else behind the map

.band
    LDY cell0
.cell
    LDA (tmap),Y:BNE behind
    INY
.lastcell
    CPY #0:BCC cell:BEQ cell            ; self-modified: the last cell
    LDA mode:BPL chosen                 ; (always: the straight block, mode's own number)
    ZA_UNREACHABLE
.behind
    LDA mode:ORA #1                     ; (the behind block: mode + 1)
.chosen
    ASL A:ASL A:ASL A:STA block
    ORA first:TAX
    LDA EntryLo,X:STA entry+1
    LDA EntryHi,X:STA entry+2

    \\ its lines: to its cell's end, or the last band's

    LDA #8:SEC:SBC first:STA n
    LDA left1:CMP n:BCC last
    SBC n:STA left1                     ; (C set)
    LDY first:BNE firstband
    BIT done                            ; (V set: a whole band, no realigning; Y = 0)
    BVS go                              ; (always)
    ZA_UNREACHABLE
.firstband
    STY realign+1                       ; (8 - n is first)
    BNE setcolend                       ; (always)
    ZA_UNREACHABLE
.last
    ADC #1:STA n                        ; (C clear) the last band's lines
    LDA #&FF:STA left1                  ; (none after it)
    LDA first:CLC:ADC n                 ; the step after its last line
    CMP #8:BCS lastrealign              ; (at its cell's end: no exit)
    ORA block:TAX
    LDA EntryLo,X:STA exit
    LDA EntryHi,X:STA exit+1
    LDY #0:LDA (exit),Y:STA saved
    LDA #&D0:STA (exit),Y               ; BNE to the block's end: Y isn't 0 after a step's INY
    INY:LDA (exit),Y:STA saved+1
    LDA ExitOff,X:STA (exit),Y
.lastrealign
    LDA #8:SEC:SBC n:STA realign+1      ; from after the last line to the next column's first
.setcolend
    LDA first:ORA fullend+1:STA colend+1    ; Y after the last column: 8 × rw + first
    LDY first
    CLV                                 ; (V clear: realign)
.go
    CLC
    LDA #0                              ; (the clears' A)
.entry
    JMP &FFFF                           ; self-modified: the block's first step
    ZA_CANJUMP StepsDraw, StepsDrawBehind, StepsClear, StepsClearBehind, StepsXor, StepsXorBehind

    \\ a column done: Y on to the next column's first step; the band's end; or the column

.stepsdone
    BVS whole                           ; (V set: a whole band; nothing here or in the steps touches V)
    TYA
.realign
    ADC #0:TAY                          ; self-modified: 8 - n (C clear: the CPY below leaves it so)
.colend
    CPY #0:BEQ banddone                 ; self-modified: Y after the last column
    LDA #0                              ; (the clears' A)
    JMP (entry+1)                       ; (the block's first step again)
    ZA_CANJUMP StepsDraw, StepsDrawBehind, StepsClear, StepsClearBehind, StepsXor, StepsXorBehind
.whole
.fullend
    CPY #0:BEQ banddone                 ; self-modified: 8 × rw
    JMP (entry+1)                       ; (the clears' A still 0)
    ZA_CANJUMP StepsDraw, StepsDrawBehind, StepsClear, StepsClearBehind, StepsXor, StepsXorBehind

.banddone
    LDA exit+1:BEQ @+                   ; the step under the BNE put back
    LDY #0:LDA saved:STA (exit),Y
    INY:LDA saved+1:STA (exit),Y
.@
    LDA left1:BMI done
    LDA #0:STA first                    ; the next band: from line 0 of the next row
    LDA srcb:CLC:ADC #8:STA srca        ; lines under the phase: this band's sprite band, 8 on
    LDA srcb+1:ADC #0:STA srca+1
    LDA srcb:CLC:ADC stride:STA srcb    ; the rest: the next sprite band
    BCC @+
    INC srcb+1
.@
    LDA tmap:CLC:ADC #32:STA tmap
    BCC @+
    INC tmap+1
.@
    LDA scr+1:CLC:ADC #2:STA scr+1
    CMP #HI(StatusAddr):BCS done        ; (the status rows)
    JMP band
.done
    RTS
}
ASSERT LO(walk.entry + 1) <> &FF, "JMP (ind)'s pointer can't end a page on an NMOS 6502"
ASSERT SpriteMaxH < 128, "walk's left1 goes negative"

\\ The steps' operands for a phase, for a pair of blocks that read the sprite (straight and behind): steps 0 to
\\ phase - 1 read srca (the sprite's band above), the rest srcb. Each pair has its own phase, so a run of walks
\\ at one phase patches once.
\\
\\ Inputs:
\\     A: the phase, 0-7
\\
\\ Outputs:
\\     the pair's phase: A
\\     A, X, Y: corrupted

MACRO SETPHASE memo, b1, s1, o1, b2, s2, o2    ; the blocks b1, b2: step k's operand at b + s × k + o
    STA memo:TAX
    LDA #srcb
FOR k = 0..7
    STA b1 + s1 * k + o1:STA b2 + s2 * k + o2
NEXT
    LDA #srca
    LDY PhaseLo,X:STY patched+1
    LDY PhaseHi,X:STY patched+2
.patched
    JMP &FFFF                           ; self-modified: into the list below, so steps phase - 1 to 0 get srca
    ZA_CANJUMP list
.list
FOR k = 7..0
    STA b1 + s1 * k + o1:STA b2 + s2 * k + o2
NEXT
    RTS
.PhaseLo                                ; where the list starts for a phase: steps phase - 1 to 0
    EQUB LO(list + 6 * (8 - (0..7)))
.PhaseHi
    EQUB HI(list + 6 * (8 - (0..7)))
ENDMACRO

.set_draw_phase
{
    SETPHASE DrawPhase, StepsDraw, 5, 1, StepsDrawBehind, 14, 4
}

.set_xor_phase
{
    SETPHASE XorPhase, StepsXor, 7, 1, StepsXorBehind, 13, 7
}

.DrawPhase                              ; the phase the draws' operands are set for
    EQUB 4
.XorPhase                               ; the XORs'
    EQUB 4

\\ The steps: each block 8 of them, unrolled, on to stepsdone. In order: ModeDraw (straight), ModeDraw behind
\\ the map, ModeClear (straight), ModeClear behind the map, ModeXor (straight), ModeXor behind the map. The
\\ sprite pointers' operands are patched for the phase (walk). An XOR behind the map changes only the pixels
\\ without bit 3, and leaves them without it, so the same pixels are masked when it's XORed off again.

.StepsDraw
FOR k = 0..7
IF k < 4
    LDA (srca),Y:STA (scr),Y:INY        ; (assembled for phase 4, so Baron sees both pointers read)
ELSE
    LDA (srcb),Y:STA (scr),Y:INY
ENDIF
NEXT
.drawend
    JMP walk.stepsdone
.StepsDrawBehind
FOR k = 0..7
    LDA (scr),Y:TAX
IF k < 4
    LDA (srca),Y:AND Hole,X:ORA Keep,X
ELSE
    LDA (srcb),Y:AND Hole,X:ORA Keep,X
ENDIF
    STA (scr),Y:INY
NEXT
.behindend
    JMP walk.stepsdone
.StepsClear
FOR k = 0..7
    STA (scr),Y:INY                     ; (A = 0)
NEXT
.clearend
    JMP walk.stepsdone
.StepsClearBehind
FOR k = 0..7
    LDA (scr),Y:TAX
    LDA Keep,X:STA (scr),Y:INY
NEXT
.clearbehindend
    JMP walk.stepsdone
.StepsXor
FOR k = 0..7
IF k < 4
    LDA (srca),Y:EOR (scr),Y:STA (scr),Y:INY
ELSE
    LDA (srcb),Y:EOR (scr),Y:STA (scr),Y:INY
ENDIF
NEXT
.xorend
    JMP walk.stepsdone
.StepsXorBehind
FOR k = 0..7
    LDA (scr),Y:TAX:LDA Hole,X
IF k < 4
    AND (srca),Y
ELSE
    AND (srcb),Y
ENDIF
    EOR (scr),Y:STA (scr),Y:INY
NEXT
.xorbehindend
    JMP walk.stepsdone

.EntryLo                                ; each block's step k, 8 a block
    EQUB LO(StepsDraw + 5 * (0..7)), LO(StepsDrawBehind + 14 * (0..7))
    EQUB LO(StepsClear + 3 * (0..7)), LO(StepsClearBehind + 9 * (0..7))
    EQUB LO(StepsXor + 7 * (0..7)), LO(StepsXorBehind + 13 * (0..7))
.EntryHi
    EQUB HI(StepsDraw + 5 * (0..7)), HI(StepsDrawBehind + 14 * (0..7))
    EQUB HI(StepsClear + 3 * (0..7)), HI(StepsClearBehind + 9 * (0..7))
    EQUB HI(StepsXor + 7 * (0..7)), HI(StepsXorBehind + 13 * (0..7))
.ExitOff                                ; a BNE at a block's step k to its end: the offset
    EQUB drawend - (StepsDraw + 5 * (0..7) + 2), behindend - (StepsDrawBehind + 14 * (0..7) + 2)
    EQUB clearend - (StepsClear + 3 * (0..7) + 2), clearbehindend - (StepsClearBehind + 9 * (0..7) + 2)
    EQUB xorend - (StepsXor + 7 * (0..7) + 2), xorbehindend - (StepsXorBehind + 13 * (0..7) + 2)
ASSERT StepsDrawBehind - StepsDraw == 5 * 8 + 3 AND StepsClear - StepsDrawBehind == 14 * 8 + 3, "step sizes"
ASSERT StepsClearBehind - StepsClear == 3 * 8 + 3 AND StepsXor - StepsClearBehind == 9 * 8 + 3, "step sizes"
ASSERT StepsXorBehind - StepsXor == 7 * 8 + 3 AND xorbehindend - StepsXorBehind == 13 * 8, "step sizes"
ASSERT behindend - (StepsDrawBehind + 2) < 128 AND xorbehindend - (StepsXorBehind + 2) < 128, "the exit's BNE reaches its block's end"

.TileRowLo                              ; the tile map's row r
    EQUB LO(TileMap + 32 * (0..PlayRows-1))
.TileRowHi
    EQUB HI(TileMap + 32 * (0..PlayRows-1))

\\ A sprite's rectangle on the screen: columns past the right edge dropped. (Nothing goes left of x 0 or above
\\ line 0; lines below the playfield are walk's to leave.)
\\
\\ Inputs:
\\     X: the sprite
\\     A: its x (MODE 0 pixels, 0-127: the sprite's shift its own), Y: its y (lines)
\\
\\ Outputs:
\\     rx, ry, rw, rh: the rectangle (rw 0: nothing)
\\     src, sw: its data and its width as stored
\\     X: preserved; A, Y: corrupted

.sprite_rect
{
    LSR A:CLC:ADC SprDX,X:STA rx        ; the first byte column
    TYA:CLC:ADC SprDY,X:STA ry
    LDA SprH,X:STA rh
    LDA SprLo,X:STA src
    LDA SprHi,X:STA src+1
    LDA SprW,X:BEQ none                 ; (a blank frame)
    STA rw:STA sw
    LDA rx:CMP #ScreenColumns:BCS none  ; (right of the screen)
    ADC rw:SBC #ScreenColumns-1         ; (C clear) the columns past the edge, if positive
    BMI fits:BEQ fits
    EOR #&FF:SEC:ADC rw:STA rw          ; rw less them
.fits
    RTS
.none
    LDA #0:STA rw
    RTS
}

\\ Phase 1 for a large sprite: the bytes of its last rectangle that its new one won't cover, cleared of every
\\ pixel but the map's.
\\
\\ Inputs:
\\     Y: its slot
\\     rx, ry, rw, rh: its new rectangle (rw 0: none: the old cleared whole)
\\
\\ Outputs:
\\     A, X, Y: corrupted

.large_edges
{
    ZA_AUTO1 slot                       ; local: the slot
    ZA_AUTO1 nx, ny, nx2, ny2           ; local: the new rectangle: its left, top, and right and bottom (past)
    ZA_AUTO1 ox, oy, ox2, oy2           ; local: the old's
    ZA_AUTO1 ys                         ; local: the first row both cover

    STY slot
    LDA SlotW,Y:BNE drawn
    RTS                                 ; (nothing drawn)
.drawn
    LDA rw:BEQ whole                    ; (no new one)
    LDA rx:STA nx:CLC:ADC rw:STA nx2
    LDA ry:STA ny:CLC:ADC rh:STA ny2
    LDA SlotX,Y:STA ox:CLC:ADC SlotW,Y:STA ox2
    LDA SlotY,Y:STA oy:CLC:ADC SlotH,Y:STA oy2

    \\ apart: the old cleared whole

    LDA nx:CMP ox2:BCS whole
    LDA ox:CMP nx2:BCS whole
    LDA ny:CMP oy2:BCS whole
    LDA oy:CMP ny2:BCC pieces           ; (overlapping)
.whole
    LDA SlotX,Y:STA rx
    LDA SlotY,Y:STA ry
    LDA SlotW,Y:STA rw
    LDA SlotH,Y:STA rh
    LDA #ModeClear:STA mode
    JMP walk                            ; (and back)

    \\ the rows above the new one, and below it, every old column

.pieces
    LDA #ModeClear:STA mode
    LDA ox:STA rx
    LDA ox2:SEC:SBC ox:STA rw
    LDA ny:CMP oy:BEQ notop:BCC notop
    SBC oy:STA rh                       ; (C set)
    LDA oy:STA ry
    JSR walk
.notop
    LDA oy2:CMP ny2:BEQ nobottom:BCC nobottom
    SBC ny2:STA rh                      ; (C set)
    LDA ny2:STA ry
    JSR walk
.nobottom

    \\ the rows both cover: the columns left of the new one, and right of it

    LDA oy:CMP ny:BCS @+
    LDA ny
.@
    STA ys:STA ry
    LDA oy2:CMP ny2:BCC @+
    LDA ny2
.@
    SEC:SBC ys:STA rh
    LDA nx:CMP ox:BEQ noleft:BCC noleft
    SBC ox:STA rw                       ; (C set)
    LDA ox:STA rx
    JSR walk
.noleft
    LDA ox2:CMP nx2:BEQ done:BCC done
    SBC nx2:STA rw                      ; (C set)
    LDA nx2:STA rx
    JMP walk                            ; (and back)
.done
    RTS
}

\\ Phase 2 for a large sprite: its new rectangle drawn (large_draw) or XORed on (large_xor_on), and kept as its
\\ slot's.
\\
\\ Inputs:
\\     Y: its slot, X: its sprite
\\     rx, ry, rw, rh, src, sw: its new rectangle and data (rw 0: none)
\\
\\ Outputs:
\\     SlotX, SlotY, SlotW, SlotH, SlotS: its slot's
\\     A, X, Y: corrupted

.large_xor_on
{
    LDA #ModeXor:BNE large_plot         ; (always)
    ZA_UNREACHABLE
}

.large_draw
{
    LDA #ModeDraw                       ; (on into large_plot)
}

.large_plot
{
    STA mode
    TXA:STA SlotS,Y
    LDA rx:STA SlotX,Y
    LDA ry:STA SlotY,Y
    LDA rh:STA SlotH,Y
    LDA rw:STA SlotW,Y:BEQ none
    JMP walk                            ; (and back)
.none
    RTS
}

\\ A large sprite XORed off its slot's rectangle (nothing if none), which stays its slot's.
\\
\\ Inputs:
\\     Y: its slot
\\
\\ Outputs:
\\     A, X, Y: corrupted

.large_xor_off
{
    LDA SlotW,Y:BEQ none
    STA rw
    LDA SlotX,Y:STA rx
    LDA SlotY,Y:STA ry
    LDA SlotH,Y:STA rh
    LDX SlotS,Y
    LDA SprLo,X:STA src
    LDA SprHi,X:STA src+1
    LDA SprW,X:STA sw
    LDA #ModeXor:STA mode
    JMP walk                            ; (and back)
.none
    RTS
}

\\ An 8-line sprite XORed, on or off (D10): its own path, no general set-up. A sprite is one stored band (w <= 3
\\ columns of 8 bytes; the set untrimmed at its top and left, so DX = DY = 0), at most two screen bands. Y runs
\\ on from 0 over its 8w bytes in the sprite and the screen alike: step i (column i DIV 8, line i MOD 8) is in
\\ the top band (xt, the sprite's top-left byte) if its line is under 8 - phase, else the bottom (xb = xt +
\\ 504). So each phase has its own 24-step run, entered at step 8 (3 - w) and left by its RTS: no phase patch,
\\ no exit patch, no realigning. Nothing is clipped (nor in the original): the logic keeps y at 168 or less.
\\
\\ Inputs:
\\     X: the sprite (the 8-line set), A: its x, Y: its y
\\
\\ Outputs:
\\     A, X, Y: corrupted

ZA_AUTO2 xt, xb, xs                     ; xor8's: the top band's pointer, the bottom's, the sprite's

.xor8
{
    ASL A:ASL A                         ; C: 8 × column's bit 8
    AND #&F8:STA xt
    LDA RowHi,Y:ADC #0:STA xt+1         ; (C clear after)
    TYA:AND #7:TAY                      ; the phase
    ORA xt:STA xt                       ; the sprite's top-left byte
    SBC #7:STA xb                       ; (C clear: less 8) xt + 504
    LDA xt+1:ADC #1:STA xb+1            ; (+ 2 less the borrow; C clear after)
    LDA SprLo,X:STA xs
    LDA SprHi,X:STA xs+1
    LDA RunLo,Y:ADC XEnt-Sprite8,X:STA run+1
    LDA RunHi,Y:ADC #0:STA run+2
    LDY #0
.run
    JMP &FFFF                           ; self-modified: the phase's run at the width's step
    ZA_CANJUMP XorRunList
}

XorRunSize = 24 * 7 + 1
.XorRuns
FOR p = 0..7
    FOR i = 0..23
        IF (i MOD 8) < 8 - p
            LDA (xs),Y:EOR (xt),Y:STA (xt),Y:INY
        ELSE
            LDA (xs),Y:EOR (xb),Y:STA (xb),Y:INY
        ENDIF
    NEXT
    RTS
NEXT
ASSERT P% - XorRuns == 8 * XorRunSize, "xor8's runs"
XorRunList = XorRuns + XorRunSize * (0..7)

.RunLo
    EQUB LO(XorRuns + XorRunSize * (0..7))
.RunHi
    EQUB HI(XorRuns + XorRunSize * (0..7))

    INPAGE 192
.RowHi                                  ; a line's character row's page
    EQUB HI(ScreenAddr) + 2 * ((0..191) DIV 8)

\\ Debris (8-line frame 2), the explosions' bulk, XORed by its own code: one routine for each even phase (its y
\\ is always even) and shift, made by tools/gensprites.py, the bytes as immediates (its zero bytes left out)
\\ through dt (the cell row's line 0 at its column) and db (dt + 512).
\\
\\ Inputs:
\\     A: x (under 120), Y: y (even)
\\
\\ Outputs:
\\     A, X, Y: corrupted

ZA_AUTO2 dt, db

.debris_xor
{
    LSR A:TAX                           ; the column; C: the shift
    TYA:AND #6:ADC #0                   ; the phase + the shift (C clear after)
    ASL A:ASL A:STA run+1               ; its JMP in DebJmps
    TXA:ASL A:ASL A:ASL A               ; C: 8 × column's bit 8
    STA dt:STA db
    LDA RowHi,Y:ADC #0:STA dt+1         ; (C clear after)
    ADC #2:STA db+1
.run
    JMP DebJmps                         ; self-modified: the low byte
    ZA_CANJUMP DebJmps + 4 * (0..7)
}
    INPAGE 32
.DebJmps                                ; the routines for phase + shift, 4 bytes apart
FOR i = 0..7
    JMP DebrisList[i]
    EQUB 0
NEXT


\\ The tables the plotter reads: Keep (a byte's bit-3 pixels) and Hole (the others' bits), for every byte.
\\
\\ Inputs:
\\     the data's bank paged in
\\
\\ Outputs:
\\     Keep, Hole
\\     A, X, Y: corrupted

.make_sprite_tables
{
    LDX #0
.byte
    LDY #0                              ; (the bits kept: &AA the left pixel's, &55 the right's)
    TXA:BPL @+
    LDY #&AA
.@
    TXA:AND #&40:BEQ @+
    TYA:ORA #&55:TAY
.@
    TYA:EOR #&FF:STA Hole,X
    TYA:STX keepx:AND keepx:STA Keep,X
    INX:BNE byte
    RTS
}
ZA_AUTO1 keepx                          ; make_sprite_tables': the byte

IF DEFINED(BENCH)
    INCLUDE "bench.6502"                ; the plotter timed over the original's plots
ENDIF
