\\ bench.6502 - the plotter timed over the original's plots (tools/bench.mjs, a build with BENCH defined): each
\\ pass, the host writes the pass's commands into CmdBuf, made from the CPC's plot log by tools/benchlog.py.
\\
\\ A command is a byte and its operands; 0 ends the list. Phase 1's come first, then phase 2's:
\\     1 slot sprite x y: phase 1 for a large sprite going to its new place: its dirty edges cleared
\\     2 slot sprite x y: phase 2: it drawn there
\\     3 slot: phase 1: it gone, its rectangle cleared
\\     4 sprite x y: an 8-line sprite XORed (off in phase 1, on in phase 2)
\\     5 slot sprite x y: a large sprite XORed off its old place and on at its new
\\     6 slot: a large sprite XORed off, gone
\\ Or the pass as objects, for plot_pass (plotpass.6502), which orders and plots them itself:
\\     10 slot sprite x y: a large sprite plotted there
\\     11 slot: a large sprite gone
\\     12 sprite x y sprite' x' y': an 8-line sprite XORed off at the first, on at the second
\\     13 sprite x y: an 8-line sprite XORed on
\\     14 sprite x y: an 8-line sprite XORed off

CmdBufSize = 1024

\\ The plotter's routines the bench calls; with BENCHNULL defined, a bare RTS, so a run times the bench's own
\\ decoding (tools/bench.mjs's times less these are the plotting alone).

IF DEFINED(BENCHNULL)
    BenchRect = bench_null
    BenchDraw = bench_null
    BenchEdges = bench_null
    BenchXorOff = bench_null
    BenchXorOn = bench_null
    BenchDebris = bench_null
    BenchXor8 = bench_null
    BenchPlotPass = bench_null
ELSE
    BenchRect = sprite_rect
    BenchDraw = large_draw
    BenchEdges = large_edges
    BenchXorOff = large_xor_off
    BenchXorOn = large_xor_on
    BenchDebris = debris_xor
    BenchXor8 = xor8
    BenchPlotPass = plot_pass
ENDIF

SECTION Workspace
.CmdBuf
    SKIP CmdBufSize
ENDSECTION

\\ A pass's commands.
\\
\\ Inputs:
\\     CmdBuf: the pass's commands
\\
\\ Outputs:
\\     A, X, Y: corrupted

.bench_pass
{
    ZA_AUTO2 cmd                        ; local: the next command
    ZA_AUTO1 op, slot, bx               ; local: its operands

    LDA #LO(CmdBuf):STA cmd
    LDA #HI(CmdBuf):STA cmd+1
.next
    LDY #0
    LDA (cmd),Y:BNE more
    RTS
.more
    CMP #10:BCC commands
    JMP bench_objects                   ; (the pass as objects; and back)
.commands
    STA op
    CMP #3:BCS notlarge

    \\ 1 or 2: a large sprite's edges, or it drawn

    INY:LDA (cmd),Y:STA slot
    INY:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LDA bx:JSR BenchRect
    LDY slot
    LDA op:CMP #1:BEQ edges
    JSR BenchDraw
    LDA #5:BNE on                       ; (always)
.edges
    JSR BenchEdges
    LDA #5:BNE on                       ; (always)
.notlarge
    BEQ gone
    CMP #5:BCC xor                      ; (4)
    BEQ xorlarge
    INY:LDA (cmd),Y:STA slot:TAY        ; 6: XORed off, gone
    JSR BenchXorOff
    LDY slot
    LDA #0:STA SlotW,Y
    LDA #2:BNE on                       ; (always)
.xorlarge
    INY:LDA (cmd),Y:STA slot:TAY
    JSR BenchXorOff
    LDY #2:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LDA bx:JSR BenchRect
    LDY slot:JSR BenchXorOn
    LDA #5
.on
    CLC:ADC cmd:STA cmd
    BCC @+
    INC cmd+1
.@
    JMP next
.gone
    INY:LDA (cmd),Y:TAY
    LDA #0:STA rw
    STY slot
    JSR BenchEdges                      ; (no new one: the old cleared whole)
    LDY slot
    LDA #0:STA SlotW,Y
    LDA #2:BNE on                       ; (always)
.xor
    INY:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LSR A:BCS general                   ; (an odd line: never debris)
    CPX #Sprite8+4:BEQ debris
    CPX #Sprite8+5:BNE general
.debris
    LDA bx:JSR BenchDebris
    LDA #4:BNE on                       ; (always)
.general
    LDA bx:JSR BenchXor8
    LDA #4:BNE on                       ; (always)
.done
    RTS
}

.bench_null                             ; (BENCHNULL's plotter)
    RTS

\\ A pass's objects (commands 10-14) into plot_pass's lists, and plot_pass.
\\
\\ Inputs:
\\     cmd: the first command
\\
\\ Outputs:
\\     A, X, Y: corrupted

.bench_objects
{
    ZA_AUTO2 at                         ; local: the next command
    ZA_AUTO1 op                         ; local: its number

    LDA bench_pass.cmd:STA at
    LDA bench_pass.cmd+1:STA at+1
    LDA #0:STA LgCount:STA SmCount:STA DbCount
.next
    LDY #0
    LDA (at),Y:BNE more
    JSR BenchPlotPass
    LDA #0:STA LgCount:STA SmCount:STA DbCount
    RTS
.more
    CMP #12:BCS small
    LDX LgCount:INC LgCount
    CMP #11:BEQ gone
    INY:LDA (at),Y:STA LgSlot,X         ; 10: plotted
    INY:LDA (at),Y:STA LgSpr,X
    INY:LDA (at),Y:STA LgX,X
    INY:LDA (at),Y:STA LgY,X
    LDA #5:JMP on
.gone
    INY:LDA (at),Y:STA LgSlot,X
    LDA #NoSprite:STA LgSpr,X
    LDA #2:JMP on
.small
    STA op
    INY:LDA (at),Y:DEY                  ; its (first) sprite: the debris has its own list
    CMP #Sprite8+4:BEQ debris
    CMP #Sprite8+5:BNE others
.debris
    LDX DbCount:INC DbCount
    LDA op:CMP #13:BEQ debrison
    BCS debrisoff
    INY:INY:LDA (at),Y:STA DbOffX,X     ; 12: moved
    INY:LDA (at),Y:STA DbOffY,X
    INY:INY:LDA (at),Y:STA DbOnX,X
    INY:LDA (at),Y:STA DbOnY,X
    LDA #7:JMP on
.debrison
    LDA #NoSprite:STA DbOffX,X
    INY:INY:LDA (at),Y:STA DbOnX,X
    INY:LDA (at),Y:STA DbOnY,X
    LDA #4:JMP on
.debrisoff
    LDA #NoSprite:STA DbOnX,X
    INY:INY:LDA (at),Y:STA DbOffX,X
    INY:LDA (at),Y:STA DbOffY,X
    LDA #4:JMP on
.others
    LDA op
    LDX SmCount:INC SmCount
    CMP #13:BEQ smallon
    BCS smalloff
    INY:LDA (at),Y:STA SmOffS,X         ; 12: moved
    INY:LDA (at),Y:STA SmOffX,X
    INY:LDA (at),Y:STA SmOffY,X
    INY:LDA (at),Y:STA SmOnS,X
    INY:LDA (at),Y:STA SmOnX,X
    INY:LDA (at),Y:STA SmOnY,X
    LDA #7:JMP on
.smallon
    LDA #NoSprite:STA SmOffS,X
    INY:LDA (at),Y:STA SmOnS,X
    INY:LDA (at),Y:STA SmOnX,X
    INY:LDA (at),Y:STA SmOnY,X
    LDA #4:JMP on
.smalloff
    LDA #NoSprite:STA SmOnS,X
    INY:LDA (at),Y:STA SmOffS,X
    INY:LDA (at),Y:STA SmOffX,X
    INY:LDA (at),Y:STA SmOffY,X
    LDA #4
.on
    CLC:ADC at:STA at
    BCC @+
    INC at+1
.@
    JMP next
}

