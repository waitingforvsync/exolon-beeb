\\ bench.6502 - the plotter timed over the original's plots (tools/bench.mjs, a build with BENCH defined): each
\\ pass, the host writes the pass's commands into CmdBuf, made from the CPC's plot log by tools/benchlog.py.
\\
\\ A command is a byte and its operands; 0 ends the list. Phase 1's come first, then phase 2's:
\\     1 slot sprite x y: phase 1 for a large sprite going to its new place: its dirty edges cleared
\\     2 slot sprite x y: phase 2: it drawn there
\\     3 slot: phase 1: it gone, its rectangle cleared
\\     4 sprite x y: an 8-line sprite XORed (off in phase 1, on in phase 2)
\\     5 slot sprite x y: a large sprite XORed off its old place and on at its new
\\     6 slot: a large sprite XORed off, gone

CmdBufSize = 1024

\\ The plotter's routines the bench calls; with BENCHNULL defined, a bare RTS, so a run times the bench's own
\\ decoding (tools/bench.mjs's times less these are the plotting alone).

IF DEFINED(BENCHNULL)
    BenchRect = bench_null
    BenchDraw = bench_null
    BenchEdges = bench_null
    BenchXorOff = bench_null
    BenchXorOn = bench_null
    BenchDebris = bench_null
    BenchXor8 = bench_null
ELSE
    BenchRect = sprite_rect
    BenchDraw = large_draw
    BenchEdges = large_edges
    BenchXorOff = large_xor_off
    BenchXorOn = large_xor_on
    BenchDebris = debris_xor
    BenchXor8 = xor8
ENDIF

SECTION Workspace
.CmdBuf
    SKIP CmdBufSize
ENDSECTION

\\ A pass's commands.
\\
\\ Inputs:
\\     CmdBuf: the pass's commands
\\
\\ Outputs:
\\     A, X, Y: corrupted

.bench_pass
{
    ZA_AUTO2 cmd                        ; local: the next command
    ZA_AUTO1 op, slot, bx               ; local: its operands

    LDA #LO(CmdBuf):STA cmd
    LDA #HI(CmdBuf):STA cmd+1
.next
    LDY #0
    LDA (cmd),Y:BNE more
    RTS
.more
    STA op
    CMP #3:BCS notlarge

    \\ 1 or 2: a large sprite's edges, or it drawn

    INY:LDA (cmd),Y:STA slot
    INY:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LDA bx:JSR BenchRect
    LDY slot
    LDA op:CMP #1:BEQ edges
    JSR BenchDraw
    LDA #5:BNE on                       ; (always)
.edges
    JSR BenchEdges
    LDA #5:BNE on                       ; (always)
.notlarge
    BEQ gone
    CMP #5:BCC xor                      ; (4)
    BEQ xorlarge
    INY:LDA (cmd),Y:STA slot:TAY        ; 6: XORed off, gone
    JSR BenchXorOff
    LDY slot
    LDA #0:STA SlotW,Y
    LDA #2:BNE on                       ; (always)
.xorlarge
    INY:LDA (cmd),Y:STA slot:TAY
    JSR BenchXorOff
    LDY #2:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LDA bx:JSR BenchRect
    LDY slot:JSR BenchXorOn
    LDA #5
.on
    CLC:ADC cmd:STA cmd
    BCC @+
    INC cmd+1
.@
    JMP next
.gone
    INY:LDA (cmd),Y:TAY
    LDA #0:STA rw
    STY slot
    JSR BenchEdges                      ; (no new one: the old cleared whole)
    LDY slot
    LDA #0:STA SlotW,Y
    LDA #2:BNE on                       ; (always)
.xor
    INY:LDA (cmd),Y:TAX
    INY:LDA (cmd),Y:STA bx
    INY:LDA (cmd),Y:TAY
    LSR A:BCS general                   ; (an odd line: never debris)
    CPX #Sprite8+4:BEQ debris
    CPX #Sprite8+5:BNE general
.debris
    LDA bx:JSR BenchDebris
    LDA #4:BNE on                       ; (always)
.general
    LDA bx:JSR BenchXor8
    LDA #4:BNE on                       ; (always)
.done
    RTS
}

.bench_null                             ; (BENCHNULL's plotter)
    RTS

