\\ testcard.6502 - the display test (Phase 0): the 16 pens dithered (tools/gendata.py) as bands down the
\\ playfield, the 8 colours plain across the status. Goes once there's a game.

\\ The test card. A page is half a row: 32 columns of 8 lines, column c's line l at c * 8 + l. Pen p fills
\\ columns 4p to 4p + 3 of the playfield, colour c columns 8c to 8c + 7 of the status.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     A, X, Y: corrupted

.test_card
{
    ZA_AUTO2 at                         ; local: the page being drawn
    ZA_AUTO1 half                       ; local: the bands before this half row's (0 or 8 pens, 0 or 4 colours)

    LDA #0:STA at:STA half
    LDA #HI(ScreenAddr):STA at+1

    \\ the playfield: pen Y DIV 32, past the half's

.pages
    LDY #0
.bytes
    TYA:LSR A:LSR A:LSR A:LSR A:LSR A
    ORA half:TAX                        ; the pen
    TYA:LSR A                           ; C: an odd line
    LDA PenEven,X
    BCC @+
    LDA PenOdd,X
.@
    STA (at),Y
    INY:BNE bytes
    LDA half:EOR #8:STA half
    INC at+1
    LDA at+1:CMP #HI(StatusAddr):BNE pages

    \\ the status: colour Y DIV 64, past the half's (half is 0 again: 44 pages flipped it)

.spages
    LDY #0
.sbytes
    TYA:ASL A:ROL A:ROL A:AND #3        ; Y DIV 64: its top two bits rolled round
    ORA half:TAX
    LDA PlainBytes,X:STA (at),Y
    INY:BNE sbytes
    LDA half:EOR #4:STA half
    INC at+1:BPL spages                 ; to &8000
    RTS
}
