\\ marker.6502 - the display test's marker (Phase 0), moved by the keys a step a pass. Goes once there's a
\\ game.

MarkerLines = 16

\\ The marker XORed on or off: 2 bytes by MarkerLines lines in markercol's colour, at markerx, markery.
\\
\\ Inputs:
\\     markerx: its left byte, 0 to ScreenColumns - 2
\\     markery: its top line, 0 to PlayRows * 8 - MarkerLines
\\     markercol: its colour, 0-7
\\
\\ Outputs:
\\     A, X, Y: corrupted

.marker
{
    ZA_AUTO2 left, right                ; local: its two columns' cells in the row
    ZA_AUTO1 ink                        ; local: its colour's byte

    LDA markery:LSR A:LSR A:AND #&FE:STA left+1 ; the row's pages: the row × 2
    LDA markerx:ASL A:ASL A:ASL A:STA left      ; the column × 8 (C: its bit 8)
    LDA left+1:ADC #HI(ScreenAddr):STA left+1
    LDA left:ADC #8:STA right           ; (C clear: the high byte's under &80)
    LDA left+1:ADC #0:STA right+1
    LDX markercol:LDA PlainBytes,X:STA ink
    LDA markery:AND #7:TAY              ; the line in the row
    LDX #MarkerLines
.line
    LDA (left),Y:EOR ink:STA (left),Y
    LDA (right),Y:EOR ink:STA (right),Y
    INY:CPY #8:BNE same
    LDY #0
    INC left+1:INC left+1               ; down a row: 512 bytes
    INC right+1:INC right+1
.same
    DEX:BNE line
    RTS
}

.PlainBytes                             ; colour c on both pixels
    EQUB Mode2Byte(0..7, 0..7)
