\\ game.6502 - the main loop. For now a zone viewer (Phase 2): Z and X step back and on through the 125 zones,
\\ each set up and drawn by zone_enter as the game will.

ZA_AUTO1 zone                           ; the zone shown, 0-124

ZoneCount = 125
TitleSeed = &6512                       ; the CPC's seed at every zone's set-up when started from the title

\\ The viewer: zone 0 first; X the next, Z the one before, a step a key press.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: it never returns

IF DEFINED(BENCH)

\\ The benchmark (bench.6502): the zone the host chose drawn, then each pass the host's commands run.
\\
\\ Inputs:
\\     zone: the zone (tools/bench.mjs writes it at game)
\\
\\ Outputs:
\\     none: it never returns

.game
{
    LDA #LO(TitleSeed):STA seed
    LDA #HI(TitleSeed):STA seed+1
    LDX zone:JSR zone_enter
    LDA #0
    LDX #MaxSlots-1
.slots
    STA SlotW,X                         ; (no large sprite drawn yet)
    DEX:BPL slots
    LDX irqframes:INX:STX wait_pass.passframe
.loop
    JSR wait_pass
.pass                                   ; (tools/bench.mjs writes the pass's commands here)
    LDA bankdata:STA &FE30              ; ROMSEL: the data's bank
    JSR bench_pass
    LDA bankcode:STA &FE30              ; ROMSEL: the code's
.passdone                               ; (and times the pass to here)
    JMP loop
}

ELIF DEFINED(VIEWER)

.game
{
    LDA #0:STA zone
.show
    LDA #LO(TitleSeed):STA seed         ; (the original's stars for the zone, to check against)
    LDA #HI(TitleSeed):STA seed+1
    LDX zone:JSR zone_enter
.shown                                  ; (the zone drawn: tools/check_zones.mjs stops here)
    LDX irqframes:INX:STX wait_pass.passframe

    \\ a key: X on, Z back; then each key let go before the next

.waitkey
    JSR wait_pass:BEQ waitkey
    LDX zone
    LSR A:BCS back                      ; (KeyLeft, Z)
    LSR A:BCC waitkey                   ; (KeyRight, X)
    INX:CPX #ZoneCount:BCC moved
    LDX #0
    BEQ moved                           ; (always)
.back
    DEX:BPL moved
    LDX #ZoneCount-1
.moved
    STX zone
.released
    JSR wait_pass:BNE released
    BEQ show                            ; (always)
    ZA_UNREACHABLE
}
ASSERT KeyLeft == 1 AND KeyRight == 2, "the viewer's keys: Z bit 0, X bit 1"

ELSE

StartZone = 0

\\ The game: a pass at a time, every second frame (D8). For now: the player, the zones, his plot.
\\
\\ Inputs:
\\     none
\\
\\ Outputs:
\\     none: it never returns

.game
{
    LDA #LO(TitleSeed):STA seed         ; (the original's seed when started from the title)
    LDA #HI(TitleSeed):STA seed+1
    LDA #StartZone:STA zone
    JSR new_game
    JSR enter_zone
    JSR draw_status
    LDX irqframes:INX:STX wait_pass.passframe
.loop
    JSR wait_pass:STA pkeys
.keyed                                  ; (tools/lockstep.mjs: the pass's keys read)
    JSR player_pass:STA pframe
    LDA PlX:BPL here                    ; (x 128: the zone's exit)
    LDA #0:STA PlX:STA PlRx             ; the next zone, from its left edge at the same height
    LDA PlY:STA PlRy
    INC zone
    LDA zone:CMP #ZoneCount:BCC @+
    LDA #0:STA zone                     ; (after the last, the first: for now)
.@
    JSR enter_zone
    JMP passed
.here
    LDA bankdata:STA &FE30              ; ROMSEL: the plotter's bank
    JSR plot_player
.passed                                 ; (tools/lockstep.mjs: the pass's logic done)
    LDA bankdata:STA &FE30              ; ROMSEL: the plotter's bank (again: after a zone's change)
    JSR plot_pass
    LDA bankcode:STA &FE30              ; ROMSEL: the code's
    JMP loop
    ZA_UNREACHABLE
}

ZA_AUTO1 pframe                         ; the player's frame this pass

\\ A game's start (the CPC's &068F): the player at 16, 112 facing right, and that the respawn point.

SECTION Workspace
.FrameLeft                              ; a frame's way: 1 its data faces right, &FF left (PlFacing's values)
    SKIP 24
ENDSECTION

.new_game
{
    LDA #16:STA PlX:STA PlRx
    LDA #112:STA PlY:STA PlRy
    LDA #0
    STA PlJump:STA PlFell:STA PlDir:STA PlCycle:STA PlDuck:STA PlSuit:STA PlExit
    LDA #99:STA Ammo
    LDA #10:STA Grenades
    LDA #9:STA Lives
    LDA #0:STA Score:STA Score+1:STA Score+2
    LDA #1:STA PlFacing:STA PlDir         ; (facing right, and walking so: the CPC's &10F1 is 1)
    LDX #23
.right
    STA FrameLeft,X                     ; (the frames as built: facing right)
    DEX:BPL right
    LDA #&FF:STA PlFrame
    RTS
}

\\ A zone set up (the CPC's &126E): drawn, its objects made; nothing drawn on it yet, so every slot is empty
\\ and the player's plotted whatever.

.enter_zone
{
    LDX zone:JSR zone_enter
    JSR draw_zone
    LDA #0
    LDX #MaxSlots-1
.slots
    STA SlotW,X
    DEX:BPL slots
    STA LgCount:STA DbCount:STA SmCount
    LDA #&FF:STA PlFrame
    RTS
}

\\ The player's plot, if his frame or his place changed: on plot_pass's list, the frame first mirrored to the way
\\ he faces if it isn't (D29: a frame's two shifts at its first plot after a turn). With the data's bank paged.

.plot_player
{
    LDX pframe
    LDA FrameLeft,X:EOR PlFacing:BPL @+ ; (0: it faces his way; &FE: the other)
    LDA PlFacing:STA FrameLeft,X        ; the frame turned the way he faces
    TXA:ASL A:TAX:JSR mirror_sprite
    INX:JSR mirror_sprite
.@
    LDA pframe:CMP PlFrame:BNE plot
    LDA PlX:CMP PlShown:BNE plot
    LDA PlY:CMP PlShown+1:BEQ done
.plot
    LDA pframe:STA PlFrame
    LDA PlX:STA PlShown
    LDA PlY:STA PlShown+1
    LDX LgCount:INC LgCount
    LDA #PlayerSlot:STA LgSlot,X
    LDA PlX:LSR A                       ; C: his shift
    LDA pframe:ROL A:STA LgSpr,X        ; frame × 2 + the shift
    LDA PlX:STA LgX,X
    LDA PlY:STA LgY,X
.done
    RTS
}

ENDIF
